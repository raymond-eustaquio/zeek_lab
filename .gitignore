# Ignore compressed archives
*.tgz
*.tar
*.tar.gz
*.gz
*.zip
*.7z

# Ignore installers (Splunk, Zeek, etc.)
*.deb
*.rpm
*.pkg
*.bin

# Ignore PCAPs
*.pcap
*.pcapng

# Ignore Zeek logs (generated)
logs_college_dns_noise/
*.log

# Ignore generated images
*.png

# Ignore Python cache
__pycache__/
*.pyc

# Ignore Jupyter autosave checkpoints
.ipynb_checkpoints/

# Ignore VSCode settings (if you use it)
.vscode/

# Ignore temporary notebook outputs (optional)
*.nbconvert.ipynb

# Ignore OS junk
.DS_Store
Thumbs.db

# Ignore json
*.secret.json
config.local.json
cache/*.json
